# Variables de entorno para las Edge Functions de TuTurno.
#
# Estas variables se configuran en Supabase con:
#   supabase secrets set RESEND_API_KEY=re_xxx
#   supabase secrets set RESEND_FROM_EMAIL=hola@tuturno.online
#   supabase secrets set APP_URL=https://tuturno.online
#
# Para el cron que invoca la Edge Function (pg_net + vault):
#   supabase secrets set SUPABASE_BASE_URL=https://tu-proyecto.supabase.co
#
# Luego cargarlas en vault desde el SQL Editor de Supabase:
#   select vault.create_secret('https://tu-proyecto.supabase.co', 'supabase_base_url');
#   select vault.create_secret('sb_secret_xxx', 'service_role_key');

# --- Edge Function: send-notifications ---

# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxx

# Email remitente (debe estar verificado en Resend)
RESEND_FROM_EMAIL=hola@tuturno.online

# URL pública del frontend (para los botones CTA de los correos)
APP_URL=https://tuturno.online

# --- Cron: invocar send-notificaciones desde pg_cron ---

# URL base del proyecto Supabase (sin barra final)
SUPABASE_BASE_URL=https://tu-proyecto.supabase.co

# Secret key de Supabase (sb_secret_...) para autenticar la llamada al cron.
# La Edge Function usa auth: ['secret'] que espera este formato, no el JWT.
# Disponible en: Project Settings → API → Secret keys
SUPABASE_SECRET_KEYS=sb_secret_xxxxxxxxxxxxx
